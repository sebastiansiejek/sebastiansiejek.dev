        "jsCode": "const names = $input.first().json.name;\n\nconst ids = names\n  .map(n => {\n    const match = n.match(/\\[(TCD-\\d+)\\]/); // tylko ID w kwadratowych []\n    return match ? match[1] : null;\n  })\n  .filter(Boolean); // wyrzuca null\n\nreturn [{ json: { taskIds: ids } }];"
