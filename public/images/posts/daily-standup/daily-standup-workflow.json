    {
      "parameters": {
        "jsCode": "const formatDurationFromSeconds = (seconds) => {\n  const totalSeconds = Math.floor(seconds);\n  const hours = Math.floor(totalSeconds / 3600);\n  const minutes = Math.floor((totalSeconds % 3600) / 60);\n  const secs = totalSeconds % 60;\n\n  const pad = (num) => num.toString().padStart(2, '0');\n\n  return `${pad(hours)}:${pad(minutes)}:${pad(secs)}`;\n}\n\nconst getJiraIssueUrl = (domain, issueKey) => {\n  return `https://${domain}/browse/${issueKey}`;\n}\n\nconst timeEntries = $('Time entries').all().map(e => e.json)\nconst jiraTasks = $('Jira tasks').all().map(t => t.json)\n\nconst grouped = Object.values(\n  timeEntries.reduce((acc, entry) => {\n    const key = entry.task.name\n\n    if (!acc[key]) {\n      const jiraIssue = jiraTasks.find(task =>\n        entry.task.name.includes(task.key)\n      )\n\n      acc[key] = {\n        task: entry.task.name,\n        description: entry.description,\n        durationSeconds: 0,\n        date: entry.date,\n        tags: new Set(),\n        ...(jiraIssue && {\n          status: jiraIssue.fields.status.name,\n          link: getJiraIssueUrl('timecampdev.atlassian.net', jiraIssue.key),\n        }),\n      }\n    }\n\n    acc[key].durationSeconds += entry.duration\n    entry.tags.forEach(tag => acc[key].tags.add(tag.name))\n\n    return acc\n  }, {})\n)\n\nreturn grouped\n  .map(item => ({\n    ...item,\n    duration: formatDurationFromSeconds(item.durationSeconds),\n    tags: [...item.tags].join(', '),\n  }))\n  .sort((a, b) => b.durationSeconds - a.durationSeconds)\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1376,
