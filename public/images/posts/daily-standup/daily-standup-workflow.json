      "id": "f25c7279-645a-4bab-9e4e-7f6a7f9217b4",
      "name": "Map time entries with jira issue"
    },
    {
      "parameters": {
        "jsCode": "const cols = ['task','description','status','tags','date','duration','link'];\n\nlet html = `\n<style>\n  table { border-collapse: collapse; font-family: system-ui, Arial; font-size: 14px; }\n  th, td { border: 1px solid #ddd; padding: 6px 8px; }\n  th { background: #f8f9fa; text-align: left; }\n  a { color: #2563eb; text-decoration: none; }\n  a:hover { text-decoration: underline; }\n</style>\n<table>\n  <thead>\n    <tr>${cols.map(c=>`<th>${c}</th>`).join('')}</tr>\n  </thead>\n  <tbody>\n`;\n\nfor (const { json } of $input.all()) {\n  html += `<tr>${cols.map(c=>{\n    let v = json[c] ?? '';\n  \n    return `<td>${String(v)\n      .replaceAll('&','&amp;')\n      .replaceAll('<','&lt;')\n      .replaceAll('>','&gt;')}</td>`;\n  }).join('')}</tr>`;\n}\n\nhtml += `</tbody></table>`;\n\nreturn [{ json: { html } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
